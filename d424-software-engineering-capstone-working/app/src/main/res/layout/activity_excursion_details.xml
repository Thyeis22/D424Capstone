<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sand">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Excursion Details"
            android:textColor="@color/deepOcean"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/excursionTitleEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Excursion Title"
            android:backgroundTint="@color/tropicalTeal"
            android:textColor="@color/darkText"
            android:textColorHint="@color/tealDark"
            android:layout_marginBottom="10dp"
            android:padding="12dp" />

        <EditText
            android:id="@+id/excursionDateEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Excursion Date MM/dd/yyyy"
            android:backgroundTint="@color/tropicalTeal"
            android:textColor="@color/darkText"
            android:textColorHint="@color/tealDark"
            android:layout_marginBottom="10dp"
            android:padding="12dp" />

        <Button
            android:id="@+id/saveExcursionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Excursion"
            android:backgroundTint="@color/oceanBlue"
            android:textColor="@color/lightText"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/deleteExcursionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete Excursion"
            android:backgroundTint="@color/sunsetOrange"
            android:textColor="@color/lightText"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/excursionAlertButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Set Excursion Alert"
            android:backgroundTint="@color/tropicalTeal"
            android:textColor="@color/lightText"
            android:layout_marginTop="10dp" />

    </LinearLayout>
</ScrollView>