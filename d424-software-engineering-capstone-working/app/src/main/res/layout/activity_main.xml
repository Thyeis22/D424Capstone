<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/sand">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Vacation Scheduler"
        android:textColor="@color/deepOcean"
        android:textSize="30sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Plan trips, excursions, alerts, and reports."
        android:textColor="@color/darkText"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/viewVacationsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Vacations"
        android:backgroundTint="@color/oceanBlue"
        android:textColor="@color/lightText"
        android:layout_marginTop="10dp" />

    <Button
        android:id="@+id/searchScreenButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Search"
        android:backgroundTint="@color/tropicalTeal"
        android:textColor="@color/lightText"
        android:layout_marginTop="10dp" />

    <Button
        android:id="@+id/reportScreenButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Generate Report"
        android:backgroundTint="@color/sunsetOrange"
        android:textColor="@color/lightText"
        android:layout_marginTop="10dp" />

</LinearLayout>