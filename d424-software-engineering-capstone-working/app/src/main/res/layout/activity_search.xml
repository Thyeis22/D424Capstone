<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sand">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Search"
            android:textColor="@color/deepOcean"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/searchEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Search vacations or excursions"
            android:backgroundTint="@color/tropicalTeal"
            android:textColor="@color/darkText"
            android:textColorHint="@color/tealDark"
            android:layout_marginBottom="10dp"
            android:padding="12dp" />

        <Button
            android:id="@+id/searchButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Search"
            android:backgroundTint="@color/oceanBlue"
            android:textColor="@color/lightText"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vacation Results"
            android:textColor="@color/deepOcean"
            android:textStyle="bold"
            android:textSize="18sp"
            android:paddingTop="16dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/vacationSearchRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:paddingTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Excursion Results"
            android:textColor="@color/deepOcean"
            android:textStyle="bold"
            android:textSize="18sp"
            android:paddingTop="16dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/excursionSearchRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:paddingTop="8dp" />

    </LinearLayout>
</ScrollView>